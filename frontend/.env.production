# Cloudflare deploy: there is no nginx proxy, so this MUST point at the deployed
# Render API (baked into the build). Derived from render.yaml service name —
# replace if your API uses a custom domain (e.g. https://api.profitlife.in).
# (For the docker-compose deploy instead, leave this empty — nginx proxies /api/*.)
VITE_API_URL=https://profitlife-api.onrender.com
